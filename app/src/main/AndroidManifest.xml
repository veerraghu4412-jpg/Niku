<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.veerraghu.niku"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".NikuApplication"
        android:allowBackup="true"
        android:label="Niku"
        android:theme="@style/Theme.Niku">
        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name="com.veerraghu.niku.notifications.ReminderReceiver" android:exported="false"/>
    </application>

</manifest>
